:root {
  --bg: #061013;
  --bg-soft: #09181b;
  --panel: rgba(11, 30, 33, 0.72);
  --panel-solid: #0b1a1d;
  --line: rgba(126, 236, 224, 0.14);
  --line-strong: rgba(126, 236, 224, 0.28);
  --text: #effffc;
  --muted: #8ba6a6;
  --accent: #23e6d2;
  --accent-soft: #87fff3;
  --white: #ffffff;
  --shadow: 0 30px 80px rgba(0, 0, 0, 0.34);
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  min-width: 320px;
  color: var(--text);
  background:
    radial-gradient(circle at 10% 0%, rgba(35, 230, 210, 0.10), transparent 32%),
    radial-gradient(circle at 90% 15%, rgba(35, 230, 210, 0.07), transparent 25%),
    var(--bg);
  font-family:
    Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
    "Segoe UI", sans-serif;
  overflow-x: hidden;
}

body::before {
  content: "";
  position: fixed;
  inset: 0;
  pointer-events: none;
  background-image:
    linear-gradient(rgba(255,255,255,.018) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,.018) 1px, transparent 1px);
  background-size: 46px 46px;
  mask-image: linear-gradient(to bottom, black, transparent 80%);
}

.noise {
  position: fixed;
  inset: 0;
  pointer-events: none;
  opacity: .035;
  z-index: 20;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 160 160' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.5'/%3E%3C/svg%3E");
}

a {
  color: inherit;
  text-decoration: none;
}

.nav {
  width: min(1240px, calc(100% - 44px));
  margin: 18px auto 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  padding: 12px 14px 12px 18px;
  background: rgba(6, 16, 19, 0.76);
  border: 1px solid var(--line);
  backdrop-filter: blur(20px);
  border-radius: 18px;
  position: relative;
  z-index: 30;
  box-shadow: 0 12px 50px rgba(0,0,0,.16);
}

.brand {
  display: inline-flex;
  align-items: center;
  gap: 12px;
}

.brand-mark {
  display: grid;
  place-items: center;
  width: 38px;
  height: 38px;
  border-radius: 11px;
  color: #03100f;
  background: var(--accent);
  font-weight: 900;
  box-shadow: 0 0 30px rgba(35,230,210,.26);
}

.brand strong {
  display: block;
  letter-spacing: .12em;
  font-size: 14px;
}

.brand small {
  display: block;
  color: var(--muted);
  font-size: 8px;
  margin-top: 3px;
  letter-spacing: .16em;
}

.nav-links {
  display: flex;
  gap: 28px;
  color: var(--muted);
  font-size: 13px;
}

.nav-links a,
footer a {
  transition: color .2s ease;
}

.nav-links a:hover,
footer a:hover {
  color: var(--accent);
}

.nav-button {
  padding: 10px 15px;
  border: 1px solid var(--line-strong);
  border-radius: 10px;
  font-size: 12px;
  background: rgba(35,230,210,.06);
}

.hero {
  width: min(1240px, calc(100% - 44px));
  min-height: 760px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1.02fr .98fr;
  gap: 52px;
  align-items: center;
  position: relative;
}

.hero-grid {
  position: absolute;
  inset: 5% -20% 0;
  background:
    radial-gradient(circle at 50% 45%, rgba(35,230,210,.13), transparent 24%),
    radial-gradient(circle at 75% 15%, rgba(35,230,210,.06), transparent 20%);
  pointer-events: none;
}

.hero-copy,
.hero-console {
  position: relative;
  z-index: 2;
}

.eyebrow,
.section-index,
.feature-tag,
.console-top,
.metric span,
.graph-header,
.online {
  letter-spacing: .15em;
  text-transform: uppercase;
  font-size: 10px;
}

.eyebrow {
  display: flex;
  align-items: center;
  gap: 9px;
  color: var(--accent-soft);
  margin-bottom: 24px;
  font-weight: 700;
}

.dot {
  opacity: .45;
}

.pulse {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--accent);
  box-shadow: 0 0 12px var(--accent);
}

h1 {
  margin: 0;
  max-width: 720px;
  font-size: clamp(64px, 8vw, 108px);
  line-height: .88;
  letter-spacing: -.065em;
}

h1 span {
  display: block;
  color: transparent;
  -webkit-text-stroke: 1px rgba(239,255,252,.38);
}

.hero-text {
  max-width: 620px;
  margin: 32px 0;
  color: var(--muted);
  font-size: 18px;
  line-height: 1.75;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
}

.button {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  min-height: 48px;
  padding: 0 18px;
  border-radius: 12px;
  font-size: 13px;
  font-weight: 750;
  transition: transform .2s ease, border-color .2s ease, background .2s ease;
}

.button:hover {
  transform: translateY(-2px);
}

.button.primary {
  color: #03100f;
  background: var(--accent);
  box-shadow: 0 10px 35px rgba(35,230,210,.20);
}

.button.secondary {
  border: 1px solid var(--line-strong);
  background: rgba(255,255,255,.025);
}

.hero-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 34px;
  margin-top: 44px;
  padding-top: 22px;
  border-top: 1px solid var(--line);
}

.hero-meta strong {
  display: block;
  font-size: 13px;
}

.hero-meta span {
  display: block;
  margin-top: 5px;
  color: var(--muted);
  font-size: 10px;
}

.console-shell {
  border: 1px solid var(--line-strong);
  border-radius: 24px;
  background: linear-gradient(145deg, rgba(17,42,45,.82), rgba(6,17,19,.94));
  box-shadow: var(--shadow);
  overflow: hidden;
  transform: perspective(1300px) rotateY(-4deg) rotateX(2deg);
}

.console-top {
  min-height: 46px;
  display: flex;
  align-items: center;
  gap: 18px;
  padding: 0 16px;
  color: #789392;
  border-bottom: 1px solid var(--line);
}

.window-dots {
  display: flex;
  gap: 5px;
  margin-right: 5px;
}

.window-dots i {
  display: block;
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #42615f;
}

.online {
  margin-left: auto;
  color: var(--accent);
}

.console-body {
  padding: 18px;
}

.status-card {
  padding: 20px;
  border: 1px solid var(--line);
  border-radius: 16px;
  background: rgba(35,230,210,.035);
}

.status-card .label,
.status-card strong,
.status-card small {
  display: block;
}

.status-card .label {
  color: var(--muted);
  font-size: 9px;
  letter-spacing: .16em;
}

.status-card strong {
  margin-top: 12px;
  color: var(--accent);
  font-size: 31px;
  letter-spacing: -.03em;
}

.status-card small {
  margin-top: 4px;
  color: var(--muted);
}

.metric-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10px;
  margin-top: 10px;
}

.metric {
  padding: 16px;
  border-radius: 14px;
  background: rgba(255,255,255,.025);
  border: 1px solid var(--line);
}

.metric span {
  color: var(--muted);
  font-size: 8px;
}

.metric strong {
  display: block;
  margin-top: 11px;
  font-size: 14px;
}

.graph {
  margin-top: 10px;
  padding: 16px 14px 8px;
  border: 1px solid var(--line);
  border-radius: 14px;
}

.graph-header {
  display: flex;
  justify-content: space-between;
  color: var(--muted);
  font-size: 8px;
}

.graph svg {
  width: 100%;
  height: 150px;
  margin-top: 8px;
}

.graph-area {
  fill: url(#area);
}

.graph-line {
  fill: none;
  stroke: var(--accent);
  stroke-width: 2.2;
  vector-effect: non-scaling-stroke;
}

.terminal {
  margin-top: 10px;
  padding: 15px 16px;
  border-radius: 14px;
  border: 1px solid var(--line);
  background: #041012;
  font-family: "SFMono-Regular", Consolas, monospace;
  font-size: 11px;
  line-height: 1.75;
}

.terminal p {
  margin: 0;
}

.terminal p span {
  color: var(--accent);
}

.terminal .ok {
  color: #a9d6d0;
}

.terminal .muted {
  color: #557270;
}

.section,
.architecture-section {
  width: min(1240px, calc(100% - 44px));
  margin: 0 auto;
  padding: 120px 0;
}

.section-heading {
  display: flex;
  justify-content: space-between;
  align-items: end;
  gap: 50px;
  margin-bottom: 50px;
}

.section-index {
  color: var(--accent);
  font-weight: 800;
}

.section-heading h2,
.cta-content h2 {
  margin: 12px 0 0;
  max-width: 760px;
  font-size: clamp(36px, 5vw, 64px);
  letter-spacing: -.055em;
  line-height: 1;
}

.section-heading > p {
  max-width: 380px;
  color: var(--muted);
  line-height: 1.7;
}

.feature-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14px;
}

.feature {
  min-height: 290px;
  padding: 26px;
  border: 1px solid var(--line);
  background: var(--panel);
  border-radius: 20px;
  transition: transform .25s ease, border-color .25s ease;
}

.feature:hover {
  transform: translateY(-5px);
  border-color: var(--line-strong);
}

.feature-number {
  color: #496866;
  font-size: 11px;
  letter-spacing: .15em;
}

.feature h3 {
  margin: 58px 0 12px;
  font-size: 24px;
}

.feature p {
  margin: 0;
  color: var(--muted);
  line-height: 1.7;
  font-size: 14px;
}

.feature-tag {
  display: inline-block;
  margin-top: 26px;
  color: var(--accent);
  font-size: 8px;
}

.architecture-section {
  padding-top: 80px;
  padding-bottom: 120px;
}

.architecture {
  border: 1px solid var(--line);
  border-radius: 28px;
  padding: 50px 28px;
  background:
    radial-gradient(circle at 50% 40%, rgba(35,230,210,.07), transparent 30%),
    rgba(8,24,27,.76);
  overflow: hidden;
}

.arch-node {
  width: min(100%, 260px);
  margin: auto;
  padding: 20px;
  text-align: center;
  border: 1px solid var(--line-strong);
  border-radius: 16px;
  background: rgba(11,30,33,.88);
  box-shadow: 0 18px 40px rgba(0,0,0,.18);
}

.arch-node.top {
  width: min(100%, 400px);
  border-color: rgba(35,230,210,.38);
  box-shadow: 0 0 50px rgba(35,230,210,.08);
}

.arch-node.api {
  width: min(100%, 330px);
}

.arch-node span {
  display: block;
  font-size: 12px;
  font-weight: 800;
  letter-spacing: .12em;
}

.arch-node small {
  display: block;
  margin-top: 6px;
  color: var(--muted);
}

.connector {
  width: 1px;
  height: 36px;
  margin: auto;
  background: linear-gradient(to bottom, var(--accent), transparent);
}

.arch-row {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12px;
}

.arch-row .arch-node {
  width: 100%;
  min-height: 105px;
  display: grid;
  align-content: center;
}

.workflow-section {
  padding-top: 80px;
}

.workflow {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  border-top: 1px solid var(--line);
}

.workflow-step {
  display: grid;
  grid-template-columns: 60px 1fr;
  gap: 16px;
  padding: 25px 0;
  border-bottom: 1px solid var(--line);
}

.workflow-step:nth-child(odd) {
  padding-right: 35px;
  border-right: 1px solid var(--line);
}

.workflow-step:nth-child(even) {
  padding-left: 35px;
}

.workflow-step > span {
  color: var(--accent);
  font-family: monospace;
  font-size: 11px;
}

.workflow-step h3 {
  margin: 0 0 7px;
  font-size: 18px;
}

.workflow-step p {
  margin: 0;
  color: var(--muted);
  font-size: 13px;
  line-height: 1.65;
}

.cta-section {
  width: min(1240px, calc(100% - 44px));
  margin: 0 auto 120px;
  padding: 100px 70px;
  position: relative;
  overflow: hidden;
  border-radius: 30px;
  border: 1px solid var(--line-strong);
  background:
    radial-gradient(circle at 78% 50%, rgba(35,230,210,.16), transparent 28%),
    linear-gradient(130deg, rgba(11,31,34,.94), rgba(5,15,17,.96));
}

.cta-grid {
  position: absolute;
  inset: 0;
  opacity: .55;
  background-image:
    linear-gradient(rgba(35,230,210,.045) 1px, transparent 1px),
    linear-gradient(90deg, rgba(35,230,210,.045) 1px, transparent 1px);
  background-size: 35px 35px;
}

.cta-content {
  position: relative;
  z-index: 2;
  max-width: 780px;
}

.cta-content p {
  max-width: 650px;
  margin: 24px 0 30px;
  color: var(--muted);
  line-height: 1.75;
}

footer {
  width: min(1240px, calc(100% - 44px));
  margin: 0 auto;
  padding: 0 0 32px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  color: var(--muted);
  font-size: 12px;
}

.footer-brand {
  display: flex;
  align-items: center;
  gap: 12px;
}

.footer-brand strong,
.footer-brand span {
  display: block;
}

.footer-brand strong {
  color: var(--text);
  letter-spacing: .12em;
}

.footer-brand span {
  margin-top: 3px;
  font-size: 8px;
  letter-spacing: .16em;
}

.reveal {
  opacity: 0;
  transform: translateY(18px);
  transition: opacity .7s ease, transform .7s ease;
}

.reveal.visible {
  opacity: 1;
  transform: translateY(0);
}

@media (max-width: 980px) {
  .nav-links {
    display: none;
  }

  .hero {
    grid-template-columns: 1fr;
    padding: 80px 0 60px;
  }

  .console-shell {
    transform: none;
  }

  .feature-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .arch-row {
    grid-template-columns: repeat(2, 1fr);
  }

  .section-heading {
    align-items: start;
    flex-direction: column;
  }
}

@media (max-width: 640px) {
  .nav,
  .hero,
  .section,
  .architecture-section,
  .cta-section,
  footer {
    width: min(100% - 28px, 1240px);
  }

  .nav-button {
    display: none;
  }

  h1 {
    font-size: 58px;
  }

  .hero-text {
    font-size: 16px;
  }

  .hero-meta {
    gap: 18px;
  }

  .metric-row,
  .feature-grid,
  .arch-row,
  .workflow {
    grid-template-columns: 1fr;
  }

  .workflow-step:nth-child(odd) {
    padding-right: 0;
    border-right: 0;
  }

  .workflow-step:nth-child(even) {
    padding-left: 0;
  }

  .cta-section {
    padding: 70px 28px;
  }

  footer {
    flex-direction: column;
    align-items: flex-start;
  }
}
