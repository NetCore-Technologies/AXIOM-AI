name: AXIOM Release

on:
  push:
    tags:
      - "v*"

permissions:
  contents: write

jobs:
  windows:
    name: Windows x64
    runs-on: windows-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v5
        with:
          ref: ${{ github.ref }}

      - name: Setup Python
        uses: actions/setup-python@v6
        with:
          python-version: "3.13"

      - name: Install dependencies
        shell: pwsh
        run: |
          python -m pip install --upgrade pip
          pip install .
          pip install "pyinstaller>=6.22,<7"

      - name: Build AXIOM
        shell: pwsh
        run: |
          pyinstaller --clean --noconfirm --onefile --name AXIOM scripts/build_entry.py

      - name: Package Windows
        shell: pwsh
        run: |
          $version = "${{ github.ref_name }}".TrimStart("v")
          New-Item -ItemType Directory -Force release | Out-Null

          Copy-Item dist/AXIOM.exe "release/AXIOM-$version-windows-x64.exe"
          Copy-Item installers/install.ps1 "release/AXIOM-$version-install.ps1"

          @"
          AXIOM $version
          Windows x64 portable build.
          "@ | Set-Content "release/README-windows.txt"

          Compress-Archive `
            -Path `
              "release/AXIOM-$version-windows-x64.exe", `
              "release/AXIOM-$version-install.ps1", `
              "release/README-windows.txt" `
            -DestinationPath `
              "release/AXIOM-$version-windows-x64-portable.zip"

      - name: Verify Windows artifacts
        shell: pwsh
        run: |
          $version = "${{ github.ref_name }}".TrimStart("v")

          if (!(Test-Path "release/AXIOM-$version-windows-x64.exe")) { exit 1 }
          if (!(Test-Path "release/AXIOM-$version-windows-x64-portable.zip")) { exit 1 }
          if (!(Test-Path "release/AXIOM-$version-install.ps1")) { exit 1 }

          Get-ChildItem release

      - name: Upload Windows artifacts
        uses: actions/upload-artifact@v4
        with:
          name: windows-release
          path: release/*

  linux:
    name: Linux x64
    runs-on: ubuntu-24.04

    steps:
      - name: Checkout
        uses: actions/checkout@v5
        with:
          ref: ${{ github.ref }}

      - name: Setup Python
        uses: actions/setup-python@v6
        with:
          python-version: "3.13"

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install .
          pip install "pyinstaller>=6.22,<7"

      - name: Build AXIOM
        run: |
          pyinstaller \
            --clean \
            --noconfirm \
            --onefile \
            --name axiom \
            scripts/build_entry.py

      - name: Install packaging tools
        run: |
          sudo apt-get update
          sudo apt-get install -y dpkg-dev

      - name: Package Linux
        run: |
          VERSION="${GITHUB_REF_NAME#v}"

          mkdir -p release
          mkdir -p AppDir/usr/bin
          mkdir -p AppDir/usr/share/applications
          mkdir -p AppDir/usr/share/icons/hicolor/256x256/apps

          cp dist/axiom "release/AXIOM-$VERSION-linux-x64"
          chmod +x "release/AXIOM-$VERSION-linux-x64"

          cp dist/axiom AppDir/usr/bin/axiom
          chmod +x AppDir/usr/bin/axiom

          cat > AppDir/axiom.desktop <<'EOF'
          [Desktop Entry]
          Name=AXIOM
          Comment=Build AI. Own AI.
          Exec=axiom
          Icon=axiom
          Type=Application
          Terminal=true
          Categories=Development;
          EOF

          cp AppDir/axiom.desktop AppDir/usr/share/applications/axiom.desktop

          cat > AppDir/axiom.svg <<'EOF'
          <svg xmlns="http://www.w3.org/2000/svg" width="256" height="256" viewBox="0 0 256 256">
            <rect width="256" height="256" rx="48" fill="#0b1020"/>
            <path d="M128 36L214 214H178L157 168H99L78 214H42L128 36ZM128 91L113 137H143L128 91Z" fill="#64ffda"/>
            <circle cx="128" cy="128" r="104" fill="none" stroke="#64ffda" stroke-width="4" opacity="0.35"/>
          </svg>
          EOF

          cp AppDir/axiom.svg AppDir/usr/share/icons/hicolor/256x256/apps/axiom.svg

          cat > AppDir/AppRun <<'EOF'
          #!/bin/sh
          HERE="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
          exec "$HERE/usr/bin/axiom" "$@"
          EOF

          chmod +x AppDir/AppRun

          curl -fL \
            -o appimagetool.AppImage \
            https://github.com/AppImage/appimagetool/releases/latest/download/appimagetool-x86_64.AppImage

          chmod +x appimagetool.AppImage

          ARCH=x86_64 \
            ./appimagetool.AppImage \
            AppDir \
            "release/AXIOM-$VERSION-linux-x64.AppImage"

          PKG="AXIOM-${VERSION}-linux-x64"

          mkdir -p \
            "$PKG/DEBIAN" \
            "$PKG/usr/bin" \
            "$PKG/usr/share/doc/axiom-ai"

          cp dist/axiom "$PKG/usr/bin/axiom"
          chmod +x "$PKG/usr/bin/axiom"

          cat > "$PKG/DEBIAN/control" <<EOF
          Package: axiom-ai
          Version: $VERSION
          Section: devel
          Priority: optional
          Architecture: amd64
          Maintainer: AXIOM
          Description: AXIOM AI development platform
           Build AI. Own AI.
          EOF

          mkdir -p "$PKG/usr/share/applications"

          cat > "$PKG/usr/share/applications/axiom.desktop" <<'EOF'
          [Desktop Entry]
          Name=AXIOM
          Comment=Build AI. Own AI.
          Exec=axiom
          Icon=axiom
          Type=Application
          Terminal=true
          Categories=Development;
          EOF

          mkdir -p "$PKG/usr/share/icons/hicolor/256x256/apps"
          cp AppDir/axiom.svg "$PKG/usr/share/icons/hicolor/256x256/apps/axiom.svg"

          cp README.md "$PKG/usr/share/doc/axiom-ai/README.md"
          cp LICENSE "$PKG/usr/share/doc/axiom-ai/LICENSE"

          cat > "release/AXIOM-$VERSION-install.sh" <<'EOF'
          #!/bin/sh
          set -eu

          PREFIX="${PREFIX:-/usr/local}"
          BIN_DIR="$PREFIX/bin"
          DESKTOP_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/applications"

          SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
          BINARY="$SCRIPT_DIR/AXIOM-__VERSION__-linux-x64"

          if [ ! -f "$BINARY" ]; then
            echo "AXIOM binary not found: $BINARY" >&2
            exit 1
          fi

          install -Dm755 "$BINARY" "$BIN_DIR/axiom"

          mkdir -p "$DESKTOP_DIR"

          cat > "$DESKTOP_DIR/axiom.desktop" <<'DESKTOP_EOF'
          [Desktop Entry]
          Name=AXIOM
          Comment=Build AI. Own AI.
          Exec=axiom
          Icon=axiom
          Type=Application
          Terminal=true
          Categories=Development;
          DESKTOP_EOF

          echo "AXIOM installed to $BIN_DIR/axiom"
          EOF

          sed -i "s/__VERSION__/$VERSION/g" "release/AXIOM-$VERSION-install.sh"
          chmod +x "release/AXIOM-$VERSION-install.sh"

          dpkg-deb --build "$PKG" "release/${PKG}.deb"
          rm -rf "$PKG"

      - name: Verify Linux artifacts
        run: |
          VERSION="${GITHUB_REF_NAME#v}"

          test -s "release/AXIOM-$VERSION-linux-x64"
          test -s "release/AXIOM-$VERSION-linux-x64.AppImage"
          test -s "release/AXIOM-$VERSION-linux-x64.deb"
          test -s "release/AXIOM-$VERSION-install.sh"

          find release -maxdepth 1 -type f -printf "%f\n" | sort

      - name: Upload Linux artifacts
        uses: actions/upload-artifact@v4
        with:
          name: linux-release
          path: release/*

  package-release-assets:
    name: Package normalized release assets
    needs: [windows, linux, package-release-assets]
    runs-on: windows-latest

    steps:
      - name: Download Windows and Linux build artifacts
        uses: actions/download-artifact@v4
        with:
          path: release-inputs
          merge-multiple: true

      - name: Prepare normalized AXIOM assets
        shell: pwsh
        env:
          TAG: ${{ github.ref_name }}
        run: |
          $ErrorActionPreference = "Stop"

          $tag = $env:TAG

          Remove-Item -Recurse -Force normalized -ErrorAction SilentlyContinue
          Remove-Item -Recurse -Force wix-build -ErrorAction SilentlyContinue

          New-Item -ItemType Directory -Force normalized | Out-Null
          New-Item -ItemType Directory -Force wix-build | Out-Null

          $files = Get-ChildItem release-inputs -Recurse -File

          function Find-BestFile {
            param(
              [string]$Extension
            )

            $candidates = @(
              $files |
                Where-Object {
                  $_.Extension -ieq $Extension
                } |
                Sort-Object @{
                  Expression = {
                    if ($_.Name -match "axiom") { 0 } else { 1 }
                  }
                }, Length -Descending
            )

            if ($candidates.Count -eq 0) {
              throw "No $Extension asset was found in the build artifacts."
            }

            return $candidates[0]
          }

          # ---------------- WINDOWS ----------------

          $exe = Find-BestFile ".exe"

          $exeName = "AXIOM-$tag-windows-x64.exe"

          Copy-Item `
            $exe.FullName `
            "normalized/$exeName" `
            -Force

          # Canonical BAT launcher.
          $batName = "AXIOM-$tag-windows-x64.bat"

          @"
          @echo off
          setlocal

          set "AXIOM_EXE=%~dp0$exeName"

          if not exist "%AXIOM_EXE%" (
            echo AXIOM executable not found:
            echo %AXIOM_EXE%
            exit /b 1
          )

          start "" "%AXIOM_EXE%" %*
          endlocal
          "@ | Set-Content `
            -Encoding ASCII `
            "normalized/$batName"

          # Canonical PowerShell installer.
          $ps1Name = "AXIOM-$tag-windows-x64.ps1"

          @"
          param(
            [switch]`$NoStart
          )

          `$ErrorActionPreference = "Stop"

          `$source = Join-Path `
            `$PSScriptRoot `
            "$exeName"

          if (-not (Test-Path `$source)) {
            throw "AXIOM executable was not found next to this installer."
          }

          `$installDir = Join-Path `
            `$env:LOCALAPPDATA `
            "AXIOM"

          New-Item `
            -ItemType Directory `
            -Force `
            -Path `$installDir | Out-Null

          `$target = Join-Path `
            `$installDir `
            "AXIOM.exe"

          Copy-Item `
            `$source `
            `$target `
            -Force

          Write-Host ""
          Write-Host "AXIOM installed to:"
          Write-Host `$target
          Write-Host ""

          if (-not `$NoStart) {
            Start-Process `$target
          }
          "@ | Set-Content `
            -Encoding UTF8 `
            "normalized/$ps1Name"

          # ---------------- LINUX ----------------

          $deb = Find-BestFile ".deb"

          $debName = "AXIOM-$tag-linux-x64.deb"

          Copy-Item `
            $deb.FullName `
            "normalized/$debName" `
            -Force

          $appImage = Find-BestFile ".AppImage"

          $appImageName = "AXIOM-$tag-linux-x64.AppImage"

          Copy-Item `
            $appImage.FullName `
            "normalized/$appImageName" `
            -Force

          # Find the raw Linux ELF binary by checking its magic bytes.
          $elf = $files |
            Where-Object {
              $_.Extension -eq "" -and $_.Length -gt 4096
            } |
            ForEach-Object {
              try {
                $bytes = Get-Content `
                  $_.FullName `
                  -Encoding Byte `
                  -TotalCount 4

                if (
                  $bytes.Count -eq 4 -and
                  $bytes[0] -eq 0x7f -and
                  $bytes[1] -eq 0x45 -and
                  $bytes[2] -eq 0x4c -and
                  $bytes[3] -eq 0x46
                ) {
                  $_
                }
              } catch {
              }
            } |
            Select-Object -First 1

          if (-not $elf) {
            throw "Could not find a raw Linux ELF executable."
          }

          $elfName = "AXIOM-$tag-linux-x64.elf"

          Copy-Item `
            $elf.FullName `
            "normalized/$elfName" `
            -Force

          # Canonical Linux installer.
          $shName = "AXIOM-$tag-linux-x64.sh"

          @"
          #!/usr/bin/env bash
          set -euo pipefail

          SCRIPT_DIR="`$(cd -- "`$(dirname -- "`${BASH_SOURCE[0]}")" && pwd)"
          SOURCE="`$SCRIPT_DIR/$elfName"
          INSTALL_DIR="`$HOME/.local/bin"
          TARGET="`$INSTALL_DIR/axiom"

          if [[ ! -f "`${SOURCE}" ]]; then
            echo "AXIOM ELF executable not found next to this installer."
            exit 1
          fi

          mkdir -p "`${INSTALL_DIR}"
          install -m 0755 "`${SOURCE}" "`${TARGET}"

          echo "AXIOM installed to:"
          echo "  `${TARGET}"
          echo
          echo "Run:"
          echo "  axiom"
          "@ | Set-Content `
            -Encoding UTF8 `
            "normalized/$shName"

          # ---------------- MSI ----------------

          choco install wixtoolset `
            --version=3.14.1 `
            -y `
            --no-progress

          $candle = Get-ChildItem `
            "C:\Program Files (x86)\WiX Toolset v3.*\bin\candle.exe" `
            -Recurse |
            Select-Object -First 1

          $light = Get-ChildItem `
            "C:\Program Files (x86)\WiX Toolset v3.*\bin\light.exe" `
            -Recurse |
            Select-Object -First 1

          if (-not $candle -or -not $light) {
            throw "WiX Toolset was not found after installation."
          }

          if ($tag -match '^v(\d+\.\d+\.\d+)(?:-(?:beta|b)\.(\d+))?$') {
            $baseVersion = $Matches[1]
            $preNumber = if ($Matches[2]) {
              [int]$Matches[2]
            } else {
              0
            }

            $msiVersion = "$baseVersion.$preNumber"
          } else {
            throw "Unsupported release tag for MSI: $tag"
          }

          $appExePath = `
            (Resolve-Path "normalized/$exeName").Path

          @"
          <?xml version="1.0" encoding="UTF-8"?>
          <Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
            <Product
              Id="*"
              Name="AXIOM"
              Language="1033"
              Version="$msiVersion"
              Manufacturer="NetCore Technologies"
              UpgradeCode="{7D9D4EF3-53A3-4CFD-9C75-1C5E8C66A120}">

              <Package
                InstallerVersion="500"
                Compressed="yes"
                InstallScope="perMachine"
                Platform="x64" />

              <MajorUpgrade
                DowngradeErrorMessage="A newer version of AXIOM is already installed." />

              <MediaTemplate />

              <Directory Id="TARGETDIR" Name="SourceDir">
                <Directory Id="ProgramFiles64Folder">
                  <Directory
                    Id="INSTALLFOLDER"
                    Name="AXIOM">

                    <Component
                      Id="AXIOMExecutable"
                      Guid="*">

                      <File
                        Id="AXIOMExe"
                        Source="$appExePath"
                        KeyPath="yes"
                        Checksum="yes" />

                    </Component>

                  </Directory>
                </Directory>
              </Directory>

              <Feature
                Id="AXIOMFeature"
                Title="AXIOM"
                Level="1">

                <ComponentRef
                  Id="AXIOMExecutable" />

              </Feature>
            </Product>
          </Wix>
          "@ | Set-Content `
            -Encoding UTF8 `
            "wix-build/Product.wxs"

          Push-Location wix-build

          & $candle.FullName `
            -arch x64 `
            -dAppExe="$appExePath" `
            Product.wxs

          & $light.FullName `
            AXIOM.wixobj `
            -o "../normalized/AXIOM-$tag-windows-x64.msi"

          Pop-Location

          # ---------------- VALIDATION ----------------

          $expected = @(
            "AXIOM-$tag-windows-x64.msi",
            "AXIOM-$tag-windows-x64.ps1",
            "AXIOM-$tag-windows-x64.bat",
            "AXIOM-$tag-windows-x64.exe",
            "AXIOM-$tag-linux-x64.deb",
            "AXIOM-$tag-linux-x64.AppImage",
            "AXIOM-$tag-linux-x64.sh",
            "AXIOM-$tag-linux-x64.elf"
          )

          foreach ($name in $expected) {
            $path = Join-Path "normalized" $name

            if (-not (Test-Path $path)) {
              throw "Missing release asset: $name"
            }
          }

          Write-Host ""
          Write-Host "Normalized AXIOM release:"
          Get-ChildItem normalized |
            Select-Object Name, Length |
            Format-Table -AutoSize

      - name: Upload normalized release asset bundle
        uses: actions/upload-artifact@v4
        with:
          name: release-assets
          path: normalized/*
          if-no-files-found: error

  publish:
    name: Publish AXIOM Release
    needs:
      - windows
      - linux
    runs-on: ubuntu-24.04

    steps:
      - name: Download Windows artifacts
        uses: actions/download-artifact@v5
        with:
          name: windows-release
          path: release

      - name: Download Linux artifacts
        uses: actions/download-artifact@v5
        with:
          name: linux-release
          path: release

      - name: Verify complete release
        shell: bash
        run: |
          VERSION="${GITHUB_REF_NAME#v}"

          required=(
            "AXIOM-$VERSION-windows-x64.exe"
            "AXIOM-$VERSION-windows-x64-portable.zip"
            "AXIOM-$VERSION-install.ps1"
            "AXIOM-$VERSION-linux-x64"
            "AXIOM-$VERSION-linux-x64.AppImage"
            "AXIOM-$VERSION-linux-x64.deb"
            "AXIOM-$VERSION-install.sh"
          )

          for file in "${required[@]}"; do
            test -s "release/$file" || {
              echo "MISSING: $file"
              exit 1
            }
          done

          cd release
          sha256sum * > SHA256SUMS
          cd ..

          echo "All required AXIOM release assets exist."
          find release -maxdepth 1 -type f -printf "%f\n" | sort

      - name: Create or Update GitHub Release
        env:
          GH_TOKEN: ${{ github.token }}
        shell: bash
        run: |
          TAG="${GITHUB_REF_NAME}"

          if [[ "$TAG" =~ ^v[0-9]+\.[0-9]+\.[0-9]+-(b|beta)\.[0-9]+$ ]]; then
            RELEASE_FLAG="--prerelease"
            echo "Publishing AXIOM beta: $TAG"
          elif [[ "$TAG" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
            RELEASE_FLAG=""
            echo "Publishing AXIOM stable release: $TAG"
          else
            echo "Unsupported AXIOM release tag: $TAG"
            exit 1
          fi

          if gh release view "$TAG" --repo "$GITHUB_REPOSITORY" >/dev/null 2>&1; then
            echo "Release $TAG already exists; updating it."

            gh release upload "$TAG" \
              --repo "$GITHUB_REPOSITORY" \
              --clobber \
              release/*

            if [[ -n "$RELEASE_FLAG" ]]; then
              gh release edit "$TAG" \
                --repo "$GITHUB_REPOSITORY" \
                --prerelease
            else
              gh release edit "$TAG" \
                --repo "$GITHUB_REPOSITORY" \
                --latest
            fi
          else
            echo "Creating release $TAG."

            gh release create "$TAG" \
              --repo "$GITHUB_REPOSITORY" \
              --title "AXIOM $TAG" \
              $RELEASE_FLAG \
              --verify-tag \
              --generate-notes \
              release/*
          fi

      - name: Apply AXIOM release notes
        env:
          GH_TOKEN: ${{ github.token }}
        shell: bash
        run: |
          TAG="${GITHUB_REF_NAME}"

          if [ -f docs/releases/RELEASE.md ]; then
            gh release edit "$TAG" \
              --repo "$GITHUB_REPOSITORY" \
              --notes-file docs/releases/RELEASE.md
          fi

      - name: Download normalized release assets
        uses: actions/download-artifact@v4
        with:
          name: release-assets
          path: release-assets

      - name: Publish exact normalized asset set
        shell: bash
        env:
          TAG: ${{ github.ref_name }}
          GH_TOKEN: ${{ github.token }}
        run: |
          set -euo pipefail

          gh release upload \
            "$TAG" \
            release-assets/* \
            --clobber

          desired=(
            "AXIOM-${TAG}-windows-x64.msi"
            "AXIOM-${TAG}-windows-x64.ps1"
            "AXIOM-${TAG}-windows-x64.bat"
            "AXIOM-${TAG}-windows-x64.exe"
            "AXIOM-${TAG}-linux-x64.deb"
            "AXIOM-${TAG}-linux-x64.AppImage"
            "AXIOM-${TAG}-linux-x64.sh"
            "AXIOM-${TAG}-linux-x64.elf"
          )

          mapfile -t existing < <(
            gh release view "$TAG" \
              --json assets \
              --jq '.assets[].name'
          )

          for asset in "${existing[@]}"; do
            keep=0

            for wanted in "${desired[@]}"; do
              if [[ "$asset" == "$wanted" ]]; then
                keep=1
                break
              fi
            done

            if [[ "$keep" -eq 0 ]]; then
              echo "Removing old asset: $asset"
              gh release delete-asset \
                "$TAG" \
                "$asset" \
                --yes
            fi
          done

          echo
          echo "Final AXIOM release assets:"
          gh release view "$TAG" \
            --json assets \
            --jq '.assets[].name' |
            sort
