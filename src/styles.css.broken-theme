.topbar{height:68px;padding:0 28px;border-bottom:1px solid rgba(255,255,255,.05);display:flex;align-items:center;justify-content:space-between;background:rgba(5,13,16,.55);backdrop-filter:blur(12px)}.breadcrumb{font-size:10px;color:#6f8587}.breadcrumb span{margin:0 6px;color:#3a5052}.top-actions{display:flex;align-items:center;gap:8px}.search{display:flex;align-items:center;gap:7px;width:210px;padding:8px 10px;border:1px solid rgba(255,255,255,.07);border-radius:10px;background:rgba(255,255,255,.026);color:#63797b}.search input{width:100%;border:0;outline:0;background:transparent;color:inherit;font-size:10px}.icon-button{width:33px;height:33px;display:grid;place-items:center;border-radius:10px;border:1px solid rgba(255,255,255,.07);background:rgba(255,255,255,.03);color:#9cafb0}.profile{display:flex;align-items:center;gap:7px;color:#95aaab;font-size:9px}.page-wrap{max-width:1600px;margin:0 auto;padding:28px 30px 40px}.page-heading{display:flex;align-items:flex-end;justify-content:space-between;gap:18px;margin-bottom:22px}.eyebrow{display:flex;align-items:center;gap:6px;color:#63dcd1;font-size:8px;font-weight:800;letter-spacing:.17em}.page-heading h2{font:700 28px 'Space Grotesk';letter-spacing:-.04em;margin:8px 0}.page-heading h2 span{color:#74dcd3}.page-heading p{margin:0;color:#74898b;font-size:11px;line-height:1.7}.primary-button,.secondary-button{display:inline-flex;align-items:center;justify-content:center;gap:8px;border-radius:10px;padding:11px 14px;font-size:10px;font-weight:800}.primary-button{border:0;color:#06201e;background:linear-gradient(145deg,#39e8d8,#21b9af);box-shadow:0 12px 32px rgba(36,222,205,.12)}.primary-button:disabled{opacity:.34;box-shadow:none;cursor:not-allowed}.secondary-button{background:rgba(255,255,255,.035);border:1px solid rgba(255,255,255,.08);color:#b1c0c1}.metric-grid,.info-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:11px;margin-bottom:12px}.info-grid{grid-template-columns:repeat(3,1fr)}.metric-card,.info-card,.panel{border:1px solid rgba(255,255,255,.06);border-radius:15px;background:rgba(255,255,255,.026);box-shadow:inset 0 1px rgba(255,255,255,.02)}.metric-card{padding:15px}.metric-icon{width:29px;height:29px;display:grid;place-items:center;border-radius:9px;background:rgba(55,221,207,.08);color:#66e4d9;margin-bottom:12px}.metric-card small{display:block;color:#647a7c;font-size:8px;text-transform:uppercase;letter-spacing:.09em}.metric-card strong{display:block;font:700 25px 'Space Grotesk';margin-top:4px}.metric-card>span{display:block;color:#55d5cb;font-size:8px;margin-top:5px}.dashboard-grid{display:grid;grid-template-columns:1.5fr 1fr;gap:11px}.panel{padding:16px;min-width:0}.wide-panel{grid-column:span 1}.panel-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px}.panel-head h3{margin:0;font:600 12px 'Space Grotesk'}.panel-head button{background:none;border:0;color:#627779;font-size:8px;letter-spacing:.13em}.chart-legend{display:flex;gap:15px;color:#627779;font-size:8px;margin-bottom:5px}.dot{display:inline-block;width:6px;height:6px;border-radius:50%;margin-right:5px}.dot.cyan{background:#39dfd1}.dot.muted{background:#405457}.chart-large{height:230px}.health-list{display:grid}.health-row{display:flex;align-items:center;gap:10px;padding:11px 0;border-bottom:1px solid rgba(255,255,255,.045)}.health-row:last-child{border-bottom:0}.health-icon{width:28px;height:28px;display:grid;place-items:center;border-radius:9px;background:rgba(255,255,255,.03);color:#6bd9cf}.health-row div:nth-child(2){flex:1}.health-row b,.health-row span{display:block}.health-row b{font-size:9px}.health-row span{font-size:8px;color:#687d7f;margin-top:3px}.timeline{display:flex;gap:10px;padding:10px 0}.timeline>i{width:7px;height:7px;border-radius:50%;background:#536a6c;margin-top:5px;box-shadow:0 0 0 4px rgba(83,106,108,.07);flex:none}.timeline .good-pin{background:#38d9ca}.timeline .warn-pin{background:#d69854}.timeline div{min-width:0}.timeline small,.timeline b,.timeline span{display:block}.timeline small{font-size:8px;color:#4f6668}.timeline b{font-size:9px;margin-top:2px}.timeline span{font-size:8px;color:#6d8183;margin-top:2px}.stack-grid{display:grid;gap:7px}.stack-card{display:flex;align-items:center;gap:9px;padding:9px;border:1px solid rgba(255,255,255,.045);border-radius:10px;background:rgba(255,255,255,.016)}.stack-icon{width:27px;height:27px;display:grid;place-items:center;border-radius:8px;background:rgba(50,218,204,.06);color:#65d9d0}.stack-card div:nth-child(2){flex:1}.stack-card b,.stack-card span{display:block}.stack-card b{font-size:9px}.stack-card span{font-size:8px;color:#687d7f;margin-top:2px}.stack-card em{font-size:7px;color:#58d7cc;font-style:normal;letter-spacing:.09em}.info-card{padding:15px}.info-card>div{display:flex;justify-content:space-between;color:#6d8284;font-size:8px}.info-card>div svg{color:#5edbd1}.info-card>b{display:block;font:700 22px 'Space Grotesk';margin:10px 0 3px}.info-card>small{color:#687c7e;font-size:8px}.data-table{overflow:auto}.table-head,.table-row{display:grid;grid-template-columns:1.35fr 1fr 1fr 1fr 1fr;gap:10px;min-width:680px}.table-head{padding:6px 2px 8px;color:#52696b;font-size:7px;letter-spacing:.12em}.table-row{padding:11px 2px;border-top:1px solid rgba(255,255,255,.045);color:#aababa;font-size:8px}.status-text{color:#58d8ce}.plan-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.plan{padding:12px;border:1px solid rgba(255,255,255,.045);border-radius:10px;background:rgba(255,255,255,.018)}.plan small,.plan b{display:block}.plan small{color:#607678;font-size:7px;text-transform:uppercase;letter-spacing:.08em}.plan b{margin-top:5px;font-size:9px}.mcp-layout{display:grid;grid-template-columns:245px 1fr;gap:11px}.mcp-servers{display:grid;gap:7px}.server-row{display:flex;align-items:center;gap:8px;padding:10px;border-radius:10px;border:1px solid rgba(255,255,255,.045);background:rgba(255,255,255,.018);color:#8fa4a5;text-align:left}.server-row.active{color:#e5f7f6;border-color:rgba(55,220,205,.24);background:rgba(42,208,195,.06)}.server-icon{width:27px;height:27px;display:grid;place-items:center;border-radius:8px;background:rgba(255,255,255,.035)}.server-row div:nth-child(2){flex:1}.server-row b,.server-row span{display:block}.server-row b{font-size:9px}.server-row span{font-size:8px;color:#607678;margin-top:2px}.diagnostic-score{display:flex;justify-content:space-between;align-items:center;padding:17px;border:1px solid rgba(255,255,255,.06);border-radius:14px;background:linear-gradient(90deg,rgba(39,214,201,.06),rgba(255,255,255,.02));margin-bottom:11px}.diagnostic-score small,.diagnostic-score strong,.diagnostic-score span{margin-right:8px}.diagnostic-score small{font-size:7px;letter-spacing:.11em;color:#627779}.diagnostic-score strong{font:700 33px 'Space Grotesk'}.diagnostic-score span{font-size:8px;color:#607678}.score-ring{width:62px;height:62px;border-radius:50%;display:grid;place-items:center;border:7px solid #203e3f;border-top-color:#42dfd1;border-right-color:#2cafa7;font-size:10px;font-weight:800}.diag-list{display:grid;gap:7px}.diag-row{display:flex;align-items:center;gap:9px;padding:12px;border:1px solid rgba(255,255,255,.045);border-radius:11px;background:rgba(255,255,255,.018)}.diag-icon{width:28px;height:28px;display:grid;place-items:center;border-radius:8px;background:rgba(51,218,204,.07);color:#54dacf}.diag-icon.warn{background:rgba(218,144,70,.09);color:#e0a15f}.diag-row div:nth-child(2){flex:1}.diag-row b,.diag-row span{display:block}.diag-row b{font-size:9px}.diag-row span{font-size:8px;color:#697e80;margin-top:3px}.diag-row em{font-size:7px;color:#55d9cf;font-style:normal;letter-spacing:.1em}.log-list{overflow:auto}.log-row{display:grid;grid-template-columns:90px 45px 140px 1fr 140px;gap:10px;min-width:700px;padding:9px 2px;border-top:1px solid rgba(255,255,255,.04);font:8px ui-monospace,SFMono-Regular,monospace;color:#839798}.log-row b{color:#58d8cd}.warn-text{color:#dfa15c!important}.log-row small{color:#52686a}
.onboarding{min-height:100vh;position:relative;display:grid;grid-template-columns:1.04fr .96fr;overflow:hidden;background:radial-gradient(circle at 73% 25%,rgba(44,224,209,.08),transparent 30%),#061014;color:#e9f5f4}.onboarding.light{background:#eff7f7;color:#112324}.onboarding.light .hero-block p,.onboarding.light .info-line span{color:#5a6e70}.ambient{position:absolute;border-radius:50%;filter:blur(100px);pointer-events:none}.ambient-a{width:360px;height:360px;left:-90px;bottom:-100px;background:rgba(42,218,205,.08)}.ambient-b{width:420px;height:420px;right:-90px;top:-120px;background:rgba(34,115,166,.06)}.onboarding-copy{position:relative;z-index:1;padding:46px 7vw 35px;display:flex;flex-direction:column;justify-content:space-between}.step-strip{display:flex;gap:14px;margin-top:24px;color:#405456;font-size:9px;letter-spacing:.15em}.step-strip span{position:relative}.step-strip span+span:before{content:'/';position:absolute;left:-9px;color:#27383a}.step-strip .active{color:#69ded3}.hero-block{max-width:570px;margin:36px 0}.hero-block h1{font:700 clamp(52px,7vw,88px)/.93 'Space Grotesk';letter-spacing:-.055em;margin:14px 0 22px}.hero-block h1 span{color:#6adeD3}.hero-block p{max-width:520px;margin:0 0 26px;color:#7f9698;font-size:12px;line-height:1.8}.principles{display:grid;gap:11px;max-width:560px}.info-line{display:flex;align-items:flex-start;gap:10px;color:#5b7173}.info-line svg{color:#62ded2}.info-line b,.info-line span{display:block}.info-line b{color:#abc0bf;font-size:8px;letter-spacing:.08em}.info-line span{font-size:8px;margin-top:2px}.tiny-footer{font-size:7px;color:#425758;letter-spacing:.17em}.onboarding-preview{display:grid;place-items:center;padding:40px;position:relative;z-index:1}.preview-window{width:min(620px,100%);padding:12px;border:1px solid rgba(255,255,255,.075);border-radius:20px;background:rgba(255,255,255,.025);backdrop-filter:blur(17px);box-shadow:0 30px 100px rgba(0,0,0,.24)}.preview-bar{display:grid;grid-template-columns:80px 1fr 65px;align-items:center;gap:10px;padding:8px 10px 13px;color:#506769;font-size:7px;letter-spacing:.14em}.traffic{display:flex;gap:4px}.traffic i{width:6px;height:6px;border-radius:50%;background:#30494b}.preview-bar>b{justify-self:end;font-size:7px;font-weight:600;display:flex;gap:5px;align-items:center}.preview-grid{display:grid;grid-template-columns:1.35fr 1fr;gap:8px}.glass-card{min-height:120px;border:1px solid rgba(255,255,255,.05);border-radius:13px;background:rgba(3,11,14,.55);padding:14px}.glass-card.wide{grid-column:span 2;min-height:95px}.glass-card small{display:block;font-size:7px;letter-spacing:.16em;color:#527073}.glass-card strong{display:block;font:700 31px 'Space Grotesk';margin:14px 0 5px}.glass-card strong span{font-size:11px;color:#59d6cc}.hero-small{display:block;font:600 15px 'Space Grotesk';margin-top:16px}.glass-card em{display:inline-block;font-style:normal;margin-top:9px;padding:4px 6px;border-radius:999px;font-size:7px;color:#5adacf;background:rgba(54,216,202,.08)}.delta{display:block;color:#51d3c8;font-size:8px;margin-top:7px}.sparkline{width:100%;height:42px}.sparkline polyline{fill:none;stroke:#36d9ca;stroke-width:2}.centered{display:grid;place-items:center;padding:30px}.setup-panel{width:min(500px,100%);padding:29px;border:1px solid rgba(255,255,255,.08);border-radius:20px;background:rgba(255,255,255,.03);backdrop-filter:blur(18px);box-shadow:0 30px 90px rgba(0,0,0,.25)}.setup-head{margin-bottom:9px}.setup-head b{font-size:15px}.compact{margin:8px 0 21px}.setup-panel h1{font:700 33px 'Space Grotesk';letter-spacing:-.045em;margin:8px 0 11px}.setup-panel h1 span{color:#6bdfd4}.setup-panel>p{font-size:10px;line-height:1.7;color:#718789;margin:0 0 20px}.field{margin:13px 0}.field>label{display:block;color:#6b8183;font-size:8px;letter-spacing:.08em;margin-bottom:6px}.input-shell{display:flex;align-items:center;gap:7px;padding:0 10px;border:1px solid rgba(255,255,255,.08);border-radius:10px;background:rgba(255,255,255,.025)}.input-shell:focus-within{border-color:rgba(65,224,210,.5);box-shadow:0 0 0 3px rgba(52,216,202,.07)}.input-shell.valid{border-color:rgba(65,223,209,.34)}.input-shell input{width:100%;padding:11px 0;border:0;outline:0;background:transparent;color:inherit;font-size:10px}.input-shell svg{color:#59d7cd}.field small{display:block;font-size:8px;color:#566c6e;margin-top:5px}.valid-text{color:#51d4c9!important}.show-button{border:0;background:none;color:#617779;font-size:8px}.requirements{display:grid;gap:5px;margin:6px 0 11px}.requirement{display:flex;align-items:center;gap:6px;color:#617577;font-size:8px}.requirement span{width:15px;height:15px;display:grid;place-items:center;border:1px solid #2a4244;border-radius:50%}.requirement.ok{color:#65ddd2}.requirement.ok span{border-color:#368d87;background:rgba(51,218,204,.07)}.full{width:100%;margin-top:7px}.secure-note{display:flex;justify-content:center;align-items:center;gap:6px;color:#4f6668;font-size:8px;margin-top:11px}
@media(max-width:1100px){.app-shell{grid-template-columns:76px 1fr}.sidebar-brand>div:last-child,.workspace-card div:nth-child(2),.nav-item span,.nav-section,.core-state b,.sidebar-bottom>small{display:none}.sidebar-brand,.workspace-card,.nav-item{justify-content:center}.metric-grid{grid-template-columns:repeat(2,1fr)}.dashboard-grid{grid-template-columns:1fr}.mcp-layout{grid-template-columns:1fr}.onboarding{grid-template-columns:1fr}.onboarding-preview{display:none}}@media(max-width:720px){.topbar{padding:0 16px}.search{display:none}.page-wrap{padding:20px 16px 30px}.page-heading{flex-direction:column;align-items:flex-start}.info-grid,.plan-grid{grid-template-columns:1fr 1fr}.onboarding-copy{padding:30px 24px}.hero-block h1{font-size:58px}}@media(max-width:480px){.app-shell{grid-template-columns:1fr}.sidebar{display:none}.metric-grid,.info-grid,.plan-grid{grid-template-columns:1fr}.page-heading h2{font-size:24px}.setup-panel{padding:22px}}

/* =========================================================
   AXIOM FINAL VISUAL OVERRIDE
   Exact Red / Purple / Blue visual system
   ========================================================= */

:root {
  --bg: #04050a !important;

  --panel: rgba(13, 14, 21, 0.78) !important;
  --panel2: rgba(17, 18, 27, 0.91) !important;
  --panel-strong: rgba(17, 18, 27, 0.91) !important;
  --panel-hover: rgba(255, 255, 255, 0.045) !important;

  --line: rgba(255, 255, 255, 0.065) !important;
  --border: rgba(255, 255, 255, 0.065) !important;
  --border-strong: rgba(255, 255, 255, 0.12) !important;

  --text: #f7f8fb !important;
  --text-h: #ffffff !important;

  --muted: rgba(255, 255, 255, 0.50) !important;
  --muted2: rgba(255, 255, 255, 0.28) !important;

  --accent: #db285f !important;
  --accent-red: #db285f !important;
  --red: #db285f !important;

  --accent-blue: #4779ff !important;
  --blue: #4779ff !important;

  --accent-purple: #9560e7 !important;
  --purple: #9560e7 !important;

  --success: #42df9d !important;
  --green: #42df9d !important;

  --accent-bg: rgba(219, 40, 95, 0.10) !important;
  --accent-border: rgba(219, 40, 95, 0.30) !important;

  --gradient-axiom:
    linear-gradient(
      100deg,
      #db285f 0%,
      #9560e7 48%,
      #4779ff 100%
    ) !important;

  --gradient-soft:
    linear-gradient(
      135deg,
      rgba(219, 40, 95, 0.18),
      rgba(149, 96, 231, 0.10),
      rgba(71, 121, 255, 0.14)
    ) !important;

  --shadow:
    0 24px 70px rgba(0, 0, 0, 0.35) !important;
}

/* ---------- GLOBAL ---------- */

html,
body,
#root {
  background: #04050a !important;
  color: #f7f8fb !important;
}

body {
  background:
    radial-gradient(
      circle at 80% 0%,
      rgba(63, 112, 255, 0.15),
      transparent 34%
    ),
    radial-gradient(
      circle at 0% 100%,
      rgba(216, 32, 86, 0.13),
      transparent 32%
    ),
    #04050a !important;
}

/* ---------- GLASS SURFACES ---------- */

.panel,
.card,
.metric,
.module-card,
.stat-card,
.dashboard-card,
.health-card,
.account-aside,
.wifi-card,
.wan-option,
.login-field,
.input-shell,
.sidebar-router {
  background:
    linear-gradient(
      145deg,
      rgba(255,255,255,.045),
      rgba(255,255,255,.012)
    ) !important;

  border-color: rgba(255,255,255,.065) !important;
  box-shadow: 0 24px 70px rgba(0,0,0,.18) !important;
}

/* ---------- SIDEBAR ---------- */

.sidebar {
  background:
    linear-gradient(
      180deg,
      rgba(18,9,17,.98),
      rgba(6,8,13,.99)
    ) !important;

  border-right-color: rgba(255,255,255,.065) !important;
}

.nav-button.active {
  color: #fff !important;

  background:
    linear-gradient(
      90deg,
      rgba(219,40,95,.22),
      rgba(71,121,255,.08)
    ) !important;

  border-color: rgba(219,40,95,.16) !important;

  box-shadow:
    inset 3px 0 0 #db285f !important;
}

.nav-button:hover {
  background: rgba(255,255,255,.035) !important;
}

/* ---------- APP HEADER ---------- */

.app-header {
  background: rgba(5,6,10,.79) !important;
  border-bottom-color: rgba(255,255,255,.065) !important;
}

/* ---------- ICON CONTAINERS ---------- */

.metric-icon,
.module-icon,
.input-icon,
.router-visual,
.wifi-icon,
.wan-icon,
.wan-option-icon {
  background:
    linear-gradient(
      135deg,
      rgba(219,40,95,.19),
      rgba(71,121,255,.14)
    ) !important;
}

/* ---------- PRIMARY BUTTONS ---------- */

.primary,
.primary-button,
.button-primary,
.hero-button,
.login-button,
.cta-button,
.error-button {
  color: #fff !important;

  background:
    linear-gradient(
      100deg,
      #db285f 0%,
      #9560e7 48%,
      #4779ff 100%
    ) !important;

  border-color: rgba(255,255,255,.06) !important;

  box-shadow:
    0 18px 42px rgba(219,40,95,.16),
    0 15px 39px rgba(71,121,255,.12) !important;
}

/* ---------- ACTIVE / SELECTED ---------- */

.selected,
.active {
  border-color: rgba(219,40,95,.25) !important;
}

.wan-option.selected {
  background:
    linear-gradient(
      145deg,
      rgba(219,40,95,.14),
      rgba(71,121,255,.08)
    ) !important;
}

/* ---------- GRADIENT HEADINGS ---------- */

.hero-copy h1 span,
.account-main h1 span,
.wifi-heading h1 span,
.wan-heading h1 span,
.login-content h1 span,
.welcome-screen h1 span {
  background:
    linear-gradient(
      92deg,
      #ff4c7c,
      #a563ff 46%,
      #4d85ff
    ) !important;

  -webkit-background-clip: text !important;
  background-clip: text !important;
  color: transparent !important;
}

/* ---------- TELEMETRY ---------- */

.chart-primary,
.chart-highlight {
  stroke: #4779ff !important;
}

.chart-secondary {
  stroke: #db285f !important;
}

.telemetry-accent,
.metric-accent {
  background:
    linear-gradient(
      135deg,
      #db285f,
      #9560e7,
      #4779ff
    ) !important;
}

/* ---------- STATUS ---------- */

.status-dot.live,
.online-dot {
  background: #42df9d !important;
  box-shadow: 0 0 10px rgba(66,223,157,.7) !important;
}

/* ---------- LINKS / ACCENT TEXT ---------- */

a:hover,
.accent,
.accent-text {
  color: #4779ff !important;
}

/* ---------- INPUT FOCUS ---------- */

.input-shell:focus-within,
.login-field:focus-within {
  border-color: rgba(71,121,255,.42) !important;

  box-shadow:
    0 0 0 3px rgba(71,121,255,.06),
    0 20px 48px rgba(0,0,0,.16) !important;
}

/* ---------- SCROLLBAR ---------- */

* {
  scrollbar-color:
    rgba(149,96,231,.55)
    rgba(255,255,255,.035) !important;
}

*::-webkit-scrollbar-thumb {
  background:
    linear-gradient(
      180deg,
      #db285f,
      #9560e7,
      #4779ff
    ) !important;

  border-radius: 99px;
}

/* ---------- RED / BLUE ATMOSPHERE ---------- */

.atmosphere-red {
  background: #db285f !important;
}

.atmosphere-blue {
  background: #4779ff !important;
}

.atmosphere-purple {
  background: #9560e7 !important;
}

