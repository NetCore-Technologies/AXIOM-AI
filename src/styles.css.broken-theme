
/* =========================================================
   AXIOM VISUAL SYSTEM
   Dark / Red / Purple / Blue
   ========================================================= */

:root {
  font-family:
    Inter,
    ui-sans-serif,
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;

  --bg: #04050a;

  --panel: rgba(13, 14, 21, 0.78);
  --panel-strong: rgba(17, 18, 27, 0.91);
  --panel-hover: rgba(255, 255, 255, 0.045);

  --border: rgba(255, 255, 255, 0.065);
  --border-strong: rgba(255, 255, 255, 0.12);

  --text: #f7f8fb;
  --text-h: #ffffff;

  --muted: rgba(255, 255, 255, 0.50);
  --muted-2: rgba(255, 255, 255, 0.28);

  --accent: #db285f;
  --accent-red: #db285f;
  --accent-blue: #4779ff;
  --accent-purple: #9560e7;

  --accent-bg: rgba(219, 40, 95, 0.10);
  --accent-border: rgba(219, 40, 95, 0.30);

  --success: #42df9d;
  --green: #42df9d;

  --warning: #f3c969;
  --danger: #ff5c78;

  --gradient-axiom:
    linear-gradient(
      100deg,
      #db285f 0%,
      #9560e7 48%,
      #4779ff 100%
    );

  --gradient-soft:
    linear-gradient(
      135deg,
      rgba(219, 40, 95, 0.18),
      rgba(149, 96, 231, 0.10) 48%,
      rgba(71, 121, 255, 0.14)
    );

  --shadow:
    0 24px 70px rgba(0, 0, 0, 0.35);

  --shadow-accent:
    0 20px 55px rgba(219, 40, 95, 0.12),
    0 20px 55px rgba(71, 121, 255, 0.10);
}

/* =========================================================
   GLOBAL ATMOSPHERE
   ========================================================= */

html,
body,
#root {
  background: var(--bg);
  color: var(--text);
}

body {
  background:
    radial-gradient(
      circle at 80% 0%,
      rgba(63, 112, 255, 0.15),
      transparent 34%
    ),
    radial-gradient(
      circle at 0% 100%,
      rgba(216, 32, 86, 0.13),
      transparent 32%
    ),
    radial-gradient(
      circle at 50% 45%,
      rgba(149, 96, 231, 0.045),
      transparent 42%
    ),
    var(--bg);
}

/* =========================================================
   AXIOM GLOW
   ========================================================= */

.axiom-glow {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
  filter: blur(125px);
  opacity: 0.16;
}

.axiom-glow-red {
  width: 520px;
  height: 520px;
  left: -230px;
  bottom: -220px;
  background: var(--accent-red);
}

.axiom-glow-blue {
  width: 540px;
  height: 540px;
  right: -240px;
  top: -230px;
  background: var(--accent-blue);
}

.axiom-glow-purple {
  width: 380px;
  height: 380px;
  left: 43%;
  top: 28%;
  background: var(--accent-purple);
  opacity: 0.055;
}

/* =========================================================
   GLASS PANELS
   ========================================================= */

.panel,
.card,
.metric,
.module-card,
.stat-card,
.dashboard-card {
  border-color: var(--border);
  background:
    linear-gradient(
      145deg,
      rgba(255, 255, 255, 0.045),
      rgba(255, 255, 255, 0.012)
    ),
    var(--panel);
  box-shadow: var(--shadow);
}

.panel:hover,
.card:hover,
.metric:hover,
.module-card:hover,
.stat-card:hover,
.dashboard-card:hover {
  border-color: var(--border-strong);
}

/* =========================================================
   PRIMARY AXIOM GRADIENT
   ========================================================= */

.axiom-gradient,
.primary-gradient,
.badge-accent {
  background: var(--gradient-axiom);
}

.text-gradient,
.gradient-text {
  background: var(--gradient-axiom);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

/* =========================================================
   BUTTONS
   ========================================================= */

button.primary,
.primary-button,
.button-primary,
.cta-button {
  color: #fff;
  background: var(--gradient-axiom);
  border: 1px solid rgba(255,255,255,.06);
  box-shadow: var(--shadow-accent);
}

button.primary:hover,
.primary-button:hover,
.button-primary:hover,
.cta-button:hover {
  filter: brightness(1.08);
  transform: translateY(-1px);
}

/* =========================================================
   INPUTS
   ========================================================= */

input,
textarea,
select {
  color: #fff;
  background:
    linear-gradient(
      145deg,
      rgba(255,255,255,.045),
      rgba(255,255,255,.011)
    );
  border-color: rgba(255,255,255,.075);
}

input:focus,
textarea:focus,
select:focus {
  border-color: rgba(71,121,255,.42);
  box-shadow:
    0 0 0 3px rgba(71,121,255,.06),
    0 20px 48px rgba(0,0,0,.16);
}

/* =========================================================
   ACTIVE NAVIGATION
   ========================================================= */

.nav-button.active,
.sidebar-nav button.active,
.sidebar-nav a.active {
  color: #fff;
  border-color: rgba(219,40,95,.18);
  background:
    linear-gradient(
      90deg,
      rgba(219,40,95,.22),
      rgba(71,121,255,.08)
    );
  box-shadow:
    inset 3px 0 0 var(--accent-red);
}

/* =========================================================
   STATUS
   ========================================================= */

.status-live,
.status-dot.live,
.online-dot {
  background: var(--success);
  box-shadow: 0 0 10px rgba(66,223,157,.7);
}

/* =========================================================
   METRIC / TELEMETRY
   ========================================================= */

.telemetry-accent,
.metric-accent {
  background: var(--gradient-axiom);
}

.chart-primary {
  stroke: var(--accent-blue);
}

.chart-secondary {
  stroke: var(--accent-red);
}

.chart-highlight {
  stroke: var(--accent-purple);
}

/* =========================================================
   LINKS
   ========================================================= */

a:hover {
  color: var(--accent-blue);
}

/* =========================================================
   SCROLLBAR
   ========================================================= */

* {
  scrollbar-width: thin;
  scrollbar-color:
    rgba(149, 96, 231, 0.45)
    rgba(255,255,255,0.035);
}

*::-webkit-scrollbar {
  width: 8px;
  height: 8px;
}

*::-webkit-scrollbar-track {
  background: rgba(255,255,255,.025);
}

*::-webkit-scrollbar-thumb {
  border-radius: 99px;
  background:
    linear-gradient(
      180deg,
      var(--accent-red),
      var(--accent-purple),
      var(--accent-blue)
    );
}

@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap');
:root{font-family:Inter,system-ui,sans-serif;color:#eaf5f5;background:#061014;font-synthesis:none;text-rendering:optimizeLegibility}*{box-sizing:border-box}body{margin:0;min-width:320px;background:#061014}button,input{font:inherit}button{cursor:pointer}
.app-shell{min-height:100vh;display:grid;grid-template-columns:248px 1fr;background:radial-gradient(circle at 75% 4%,rgba(51,219,206,.08),transparent 28%),linear-gradient(180deg,#061014,#091417)}.light{background:#eef6f6;color:#102425}.light .sidebar,.light .topbar{background:rgba(250,253,253,.9);border-color:rgba(0,0,0,.08)}.light .panel,.light .metric-card,.light .info-card{background:rgba(255,255,255,.55);border-color:rgba(0,0,0,.08)}
